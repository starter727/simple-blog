# ===========================================
# 应用配置
# ===========================================

# 应用名称（显示在页面标题）
APP_NAME=My Blog

# 调试模式（true/false）
# - true: 开发模式，显示详细错误
# - false: 生产模式，隐藏错误详情
DEBUG=false

# ===========================================
# 数据库配置
# ===========================================

# 数据库连接字符串
# 默认使用 SQLite，文件保存在项目根目录
# 如需使用 PostgreSQL：
# DATABASE_URL=postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///blog.db

# ===========================================
# 内容源配置（二选一）
# ===========================================

# 方案一：本地目录（默认）
# Markdown 文件存放在项目根目录的 content 文件夹
# CONTENT_DIR=./content

# 方案二：GitHub 仓库（推荐）
# 从 GitHub 仓库直接读取内容，不占用服务器存储
# 格式：owner/repo（例如：starter727/blog-content）
# GITHUB_CONTENT_REPO=starter727/blog-content

# GitHub 内容目录路径（相对于仓库根目录）
# GITHUB_CONTENT_PATH=content

# GitHub 分支（默认：main）
# GITHUB_CONTENT_BRANCH=main

# ===========================================
# 认证配置（重要！）
# ===========================================

# JWT 签名密钥（必须修改！）
# 用于加密用户登录凭证
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this

# Token 过期时间（分钟）
# 默认 1440 分钟 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# 管理员账号（首次运行时创建）
# ===========================================

# 管理员用户名（首次运行时自动创建）
ADMIN_USERNAME=admin

# 管理员密码（首次运行时自动创建）
# 建议使用强密码，至少 12 位
ADMIN_PASSWORD=your-strong-password

# ===========================================
# GitHub Webhook 配置（可选）
# ===========================================

# Webhook 密钥（用于验证 GitHub 请求）
# 在 GitHub 仓库设置中配置相同的密钥
# 留空则不验证签名
WEBHOOK_SECRET=
